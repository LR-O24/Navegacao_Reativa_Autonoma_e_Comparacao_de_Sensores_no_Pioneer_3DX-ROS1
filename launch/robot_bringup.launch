<launch>
  <!-- Rodar NO PC DO ROBO (onde o SICK esta ligado).
       Compativel com ROS Hydro (sem $(eval)). O roscore deve estar ativo.

       Se o RosAria JA estiver rodando (confira: rosnode list), use start_rosaria:=false.
       Nunca suba dois RosAria: o ROS derruba o no mais antigo de mesmo nome. -->

  <arg name="start_rosaria" default="false"/>
  <arg name="port"          default="/dev/ttyS0"/>

  <!-- SICK LMS291-S05 por RS-232 (driver sicktoolbox_wrapper/sicklms).
       RS-232 suporta ate 38400 baud. start_lidar:=false para subir o driver manualmente. -->
  <arg name="start_lidar"       default="true"/>
  <arg name="lms2xx_port"       default="/dev/ttyS1"/>
  <arg name="lms2xx_baud"       default="38400"/>
  <arg name="lms2xx_angle"      default="180"/>
  <arg name="lms2xx_resolution" default="1.0"/>
  <arg name="lidar_frame"       default="laser"/>

  <!-- Posicao do LIDAR em relacao ao base_link [m, rad] -->
  <arg name="start_tf"  default="true"/>
  <arg name="laser_x"   default="0.10"/>
  <arg name="laser_y"   default="0.0"/>
  <arg name="laser_z"   default="0.20"/>
  <arg name="laser_yaw" default="0.0"/>

  <group if="$(arg start_rosaria)">
    <node pkg="rosaria" type="RosAria" name="RosAria" output="screen">
      <param name="port" value="$(arg port)"/>
    </node>
  </group>

  <group if="$(arg start_lidar)">
    <node pkg="sicktoolbox_wrapper" type="sicklms" name="sicklms" output="screen">
      <param name="port" value="$(arg lms2xx_port)"/>
      <param name="baud" value="$(arg lms2xx_baud)"/>
      <param name="angle" value="$(arg lms2xx_angle)"/>
      <param name="resolution" value="$(arg lms2xx_resolution)"/>
      <param name="frame_id" value="$(arg lidar_frame)"/>
    </node>
  </group>

  <!-- TF base_link -> laser. O frame deve coincidir com o frame_id de /scan
       (confira: rostopic echo -n1 /scan/header/frame_id). -->
  <group if="$(arg start_tf)">
    <node pkg="tf" type="static_transform_publisher" name="base_to_laser"
          args="$(arg laser_x) $(arg laser_y) $(arg laser_z) $(arg laser_yaw) 0 0 base_link $(arg lidar_frame) 50"/>
  </group>
</launch>
