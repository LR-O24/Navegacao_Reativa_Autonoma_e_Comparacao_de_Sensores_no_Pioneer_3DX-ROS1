<?xml version="1.0"?>
<package>
  <name>pioneer_reactive_nav</name>
  <version>1.0.0</version>
  <description>
    Navegacao reativa autonoma para o Pioneer 3DX (ROS 1) com selecao de
    sensor (LIDAR ou sonars) por arquivo .yaml, e ferramentas de analise
    comparativa entre os sensores.
  </description>
  <maintainer email="grupo@exemplo.com">Grupo Pioneer</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>std_msgs</build_depend>

  <run_depend>rospy</run_depend>
  <run_depend>sensor_msgs</run_depend>
  <run_depend>geometry_msgs</run_depend>
  <run_depend>nav_msgs</run_depend>
  <run_depend>std_msgs</run_depend>
</package>
